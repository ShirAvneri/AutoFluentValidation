<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Authors>AutoFluentValidation contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Compile-time generation of FluentValidation validators from attributes, DataAnnotations and conventions.</Description>
    <PackageProjectUrl>https://github.com/ShirAvneri/AutoFluentValidation</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShirAvneri/AutoFluentValidation.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink (built into the .NET 8+ SDK) and symbol packages, so consumers can step into the library. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Reproducible paths in official builds (GitHub Actions sets GITHUB_ACTIONS=true). -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
