<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    A NuGet PackageReference imports build/AutoFluentValidation.props and .targets automatically.
    This sample uses ProjectReferences, so it imports them by hand (the .targets via Directory.Build.targets,
    which runs after the SDK has defined IntermediateOutputPath).
  -->
  <Import Project="..\..\src\AutoFluentValidation\build\AutoFluentValidation.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoFluentValidation\AutoFluentValidation.csproj" />
    <!-- When consuming the NuGet package this line is unnecessary: the generator ships inside it. -->
    <ProjectReference Include="..\..\src\AutoFluentValidation.SourceGenerator\AutoFluentValidation.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
